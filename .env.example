# Woxus - API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-live-preview

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8457

# Memory
MEMORY_DB_PATH=woxus_memory.db

# Trial (seconds)
TRIAL_DURATION_SECONDS=600

# License server URL (admin panel)
LICENSE_SERVER_URL=https://woxus-a.vercel.app

# Allowed terminal commands (comma-separated, empty = all allowed)
ALLOWED_COMMANDS=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
