# Woxus - API Keys
# Copy this file to .env and fill in your keys

# Google Gemini API — the only key you need
# Gemini Live API handles: STT (speech-to-text), TTS (text-to-speech),
# streaming conversation, interruption handling, affective dialog
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-live-preview

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Memory
MEMORY_DB_PATH=woxus_memory.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs