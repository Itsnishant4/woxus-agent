# Copy to .env.local for local development — same vars Vercel sets in production.
# Development admin then serves every API route identically to woxus-admin.vercel.app.

# MongoDB connection string (prod + dev should point at the same DB for identical license data)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/woxus

# JWT secret for admin session auth (any long random string locally)
JWT_SECRET=dev-secret-change-me
